{
  "name": "media-player-element",
  "version": "2.1.0",
  "description": "A media player you write in HTML — one custom element over the <audio> or <video> you already wrote",
  "type": "module",
  "main": "src/scripts/media-player.js",
  "style": "src/styles/index.scss",
  "customElements": "custom-elements.json",
  "exports": {
    ".": "./src/scripts/media-player.js",
    "./style.scss": "./src/styles/index.scss",
    "./style.css": "./dist/media-player.css",
    "./bundle.css": "./dist/media-player.bundle.css",
    "./theme.scss": "./src/styles/theme.scss",
    "./theme.css": "./dist/media-player-theme.css",
    "./bundle-theme.css": "./dist/media-player-theme.bundle.css",
    "./custom-elements.json": "./custom-elements.json",
    "./package.json": "./package.json"
  },
  "files": [
    "custom-elements.json",
    "src/scripts/media-player.js",
    "src/styles/index.scss",
    "src/styles/theme.scss",
    "dist/media-player.mjs",
    "dist/media-player.min.mjs",
    "dist/media-player.css",
    "dist/media-player.min.css",
    "dist/media-player-theme.css",
    "dist/media-player-theme.min.css",
    "dist/media-player.bundle.css",
    "dist/media-player.bundle.min.css",
    "dist/media-player-theme.bundle.css",
    "dist/media-player-theme.bundle.min.css"
  ],
  "homepage": "https://stamat.github.io/media-player-element/",
  "repository": {
    "type": "git",
    "url": "https://github.com/stamat/media-player-element.git"
  },
  "keywords": [
    "media-player",
    "audio-player",
    "video-player",
    "custom-elements",
    "web-components",
    "light-dom",
    "accessibility",
    "progressive-enhancement"
  ],
  "author": "Nikola Stamatovic <@stamat>",
  "contributors": [],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/stamat/media-player-element/issues"
  },
  "scripts": {
    "dev": "poops",
    "build": "poops -b && cem analyze",
    "prepack": "npm run build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint . && stylelint \"src/**/*.scss\"",
    "lint:es": "es-check --module es2020 \"dist/**/*.mjs\""
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {}
  },
  "peerDependencies": {
    "book-of-elementals": "^3.3.0",
    "hydrargyri": "^2.3.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/js": "^10.0.1",
    "book-of-elementals": "^3.3.0",
    "code-preview-element": "^3.0.4",
    "es-check": "^9.6.4",
    "eslint": "^10.7.0",
    "hydrargyri": "^2.3.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.0.0",
    "poops": "^3.0.0",
    "poops-docs-theme": "^5.1.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0"
  }
}
